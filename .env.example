# ---------- API FastAPI (backend) ----------
# Adresse d'Ollama et modèle utilisé par le moteur d'analyse
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Délai maximal (secondes) d'une requête vers Ollama
OLLAMA_TIMEOUT=180
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Mettre à true pour afficher l'adresse d'Ollama dans Paramètres (environnement local uniquement)
EXPOSE_OLLAMA_URL=false
MAX_JOBS_IN_MEMORY=50

# ---------- Frontend Next.js : copier dans frontend/.env.local ----------
# NEXT_PUBLIC_API_URL=http://localhost:8000
