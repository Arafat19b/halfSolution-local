# =============================================================
# HalfSolution — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs manquantes.
# Ne jamais committer .env dans git.
# =============================================================

# ----- Moteur LLM actif ("groq" ou "ollama") ----------------
# Groq est sélectionné automatiquement si GROQ_API_KEY est présent.
# Forcer un moteur en décommentant la ligne suivante :
# LLM_ENGINE=groq

# ----- Groq (cloud — recommandé en production) --------------
GROQ_API_KEY=            # Obligatoire si LLM_ENGINE=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=60

# ----- Ollama (local — dev uniquement) ----------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
# Afficher l'adresse Ollama dans l'UI (local uniquement)
EXPOSE_OLLAMA_URL=false

# ----- API FastAPI ------------------------------------------
CORS_ORIGINS=http://localhost:3000
# En production, remplacer par l'URL Vercel :
# CORS_ORIGINS=https://your-app.vercel.app

MAX_JOBS_IN_MEMORY=50

# ----- Frontend Next.js (copier dans frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
